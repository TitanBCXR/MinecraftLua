# --- CC: Tweaked runtime files (generated on the in-game computers, not source) ---
*.cfg              # poi.cfg, worker.cfg, station.cfg, ...
master.pw          # master-password floppy contents (secret!)
.titan-install     # per-device install source manifest (runtime)
.titan-net         # remembered main router / data-center auth (runtime)
packages           # per-device desired package list (runtime)
builds/            # scanned build presets uploaded/saved at runtime
computer/          # world-save computer mounts, if ever copied in
disk/              # world-save disk mounts, if ever copied in

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
.vscode/
.idea/
